# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# ...but dist IS committed so plugin manifests can run the MCP server from a
# fresh clone without a build step (npm install is still required for
# workspace symlinks and external deps)
!packages/*/dist/
!packages/*/dist/**

# Freebuff app internals (local workspace only)
.freebuff/
desktop-v2.db
desktop-v2.db-shm
desktop-v2.db-wal

# Logs & temp
*.log
*.tmp
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Drift local state (never commit a repo's own live drift state)
.drift/keys/

# Live embedded repo generated by scripts/seed-demo.sh (committed copy is the file snapshot)
examples/demo-repo/.git/
